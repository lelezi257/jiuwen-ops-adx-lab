# Copy to .local/model.env; chmod 600. Used ONLY by jiuwen-runner.
# No credentials are committed. Empty fields keep real-model tasks waiting.
API_BASE=
API_KEY=
MODEL_NAME=
MODEL_PROVIDER=OpenAI
ENDPOINT_PROFILE=openai
LAB_MAX_TURNS=40
LAB_RUN_TIMEOUT=900
# Optional: requires model-reported USD cost; unknown cost fails closed.
LAB_MAX_BUDGET_USD=
